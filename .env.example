# Telegram Bot Token (ստացեք @BotFather-ից)
# Կարող եք անվանել BOT_TOKEN, TOKEN կամ BOT
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Google Gemini API Key (ստացեք aistudio.google.com-ից)
GEMINI_API_KEY="AIzaSy..."

# Տվյալների բազայի հասցեն (լոկալ SQLite ֆայլի համար)
DATABASE_URL="sqlite:///./local_bot.db"

# Ձեր Telegram User ID-ն՝ /admin վահանակից օգտվելու համար
ADMIN_USER_IDS="123456789"
